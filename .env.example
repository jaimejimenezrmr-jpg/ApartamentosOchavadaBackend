# Referencia de variables para ejecutar el backend fuera de Docker. En producción se usan las plantillas de
# ../ApartamentosOchavadaInfra (.env.example y backend.env.example).

# --- Base de datos ---
DB_URL=jdbc:postgresql://postgres:5432/ochavada
DB_USERNAME=ochavada
DB_PASSWORD=cambia-esta-contraseña

# --- JWT ---
# openssl rand -base64 48
JWT_SECRET=
JWT_ISSUER=https://api.apartamentosochavada.com

# --- CORS (orígenes del frontend, separados por comas) ---
CORS_ALLOWED_ORIGINS=https://apartamentosochavada.com,https://www.apartamentosochavada.com

# --- Stripe (claves sk_test_/pk_test_ en desarrollo) ---
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
# Dashboard > Developers > Webhooks > endpoint https://api.../api/v1/webhooks/stripe
# Eventos: payment_intent.succeeded, payment_intent.payment_failed, payment_intent.processing,
#          payment_intent.requires_action, payment_intent.canceled
STRIPE_WEBHOOK_SECRET=

# --- Email (SMTP) ---
# Con Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USERNAME=apartamentosochavada@gmail.com y como
# SMTP_PASSWORD una "contraseña de aplicación" (requiere verificación en 2 pasos en la cuenta de Google).
# Gmail exige que MAIL_FROM sea la misma cuenta. Para volumen alto: Brevo, Amazon SES, Postmark...
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=apartamentosochavada@gmail.com
SMTP_PASSWORD=
MAIL_FROM=apartamentosochavada@gmail.com
MAIL_REPLY_TO=

# --- Portal del huésped y datos de contacto ---
GUEST_PORTAL_URL=https://apartamentosochavada.com/mi-estancia
PROPERTY_ADDRESS=Calle Pescaderías, 6, 14920 Aguilar de la Frontera (Córdoba)
PROPERTY_PHONE=
PROPERTY_EMAIL=apartamentosochavada@gmail.com

# --- Cifrado de credenciales de integraciones (openssl rand -base64 32) ---
APP_CREDENTIALS_KEY=

# --- TTLock (https://euopen.ttlock.com > Developer > Application) ---
TTLOCK_ENABLED=false
TTLOCK_BASE_URL=https://euapi.ttlock.com
TTLOCK_CLIENT_ID=
TTLOCK_CLIENT_SECRET=
# Usuario de la app TTLock propietario de las cerraduras (la contraseña en claro; se envía como MD5)
TTLOCK_USERNAME=
TTLOCK_PASSWORD=

# --- SES.HOSPEDAJES (credenciales del servicio web recibidas al registrarse en la sede del Ministerio) ---
SES_ENABLED=false
SES_ENDPOINT=https://hospedajes.pre-ses.mir.es/hospedajes-web/ws/v1/comunicacion
SES_USERNAME=
SES_PASSWORD=
# Códigos de 10 dígitos, conservando los ceros a la izquierda
SES_LANDLORD_CODE=
SES_ESTABLISHMENT_CODE=
SES_REPORT_RESERVATIONS=true
# Solo si la JVM no confía en el certificado del servicio (PKCS12 o JKS con el certificado importado)
SES_TRUSTSTORE_PATH=
SES_TRUSTSTORE_PASSWORD=

# --- Facturación (datos fiscales del emisor) ---
INVOICE_ISSUER_NAME=
INVOICE_ISSUER_TAX_ID=
INVOICE_ISSUER_ADDRESS=Calle Pescaderías, 6, 14920 Aguilar de la Frontera (Córdoba)
VERIFACTU_ENABLED=false

# --- Channel manager Beds24 (Booking.com, Airbnb, Expedia, Google Hotel Center) ---
BEDS24_ENABLED=false
BEDS24_BASE_URL=https://api.beds24.com/v2
# Opcional: refresh token ya generado; si no, conectar con un código de invitación desde el backoffice
BEDS24_REFRESH_TOKEN=
# Secreto que Beds24 envía en la cabecera X-Ochavada-Webhook-Token (openssl rand -hex 32)
BEDS24_WEBHOOK_TOKEN=
BEDS24_SYNC_HORIZON_DAYS=365
BEDS24_OTA_COLLECT_CHANNELS=airbnb,expedia
BEDS24_PUSH_BOOKINGS=true

# --- Administrador inicial (eliminar tras el primer arranque) ---
APP_BOOTSTRAP_ADMIN_EMAIL=
APP_BOOTSTRAP_ADMIN_PASSWORD=
APP_BOOTSTRAP_ADMIN_NAME=Administrador
